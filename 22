int is_leap(int y) {
    if ((y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)) {
        return 1;
    } else {
        return 0;
    }
}

int days_in_month(int m, int y) {
    if (m == 2) {
        if (is_leap(y) == 1) {
            return 29;
        } else {
            return 28;
        }
    } else if (m == 4 || m == 6 || m == 9 || m == 11) {
        return 30;
    } else {
        return 31;
    }
}
