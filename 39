#include <stdio.h>

int add(int a, int b);
int sub(int a, int b);
int mul(int a, int b);
int divide(int a, int b);

int main() {
    int k;
    if (scanf("%d", &k) != 1) {
        return 0;
    }

    for (int i = 0; i < k; i++) {
        int a, b;
        char op;
        scanf("%d %c %d", &a, &op, &b);

        if (op == '+') {
            printf("%d\n", add(a, b));
        } else if (op == '-') {
            printf("%d\n", sub(a, b));
        } else if (op == '*') {
            printf("%d\n", mul(a, b));
        } else if (op == '/') {
            if (b == 0) {
                printf("ERROR\n");
            } else {
                printf("%d\n", divide(a, b));
            }
        }
    }

    return 0;
}

int add(int a, int b) {
    return a + b;
}

int sub(int a, int b) {
    return a - b;
}

int mul(int a, int b) {
    return a * b;
}

int divide(int a, int b) {
    return a / b;
}
